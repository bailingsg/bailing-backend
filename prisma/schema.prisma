// Bailing Wooden B2B Website - Prisma Schema
// Phase 1 仅建立基础数据模型，不包含业务数据种子。
// 所有数据库变更必须通过 prisma migrate 管理，禁止手改数据库结构。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

enum AdminRole {
  ADMIN // 超级管理员
  EDITOR // 内容编辑
}

enum ProductStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布
  ARCHIVED // 已归档
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// RFQ（Request For Quotation）状态流转：新询盘 → 已联系 → 已报价 → 已关闭
enum RfqStatus {
  NEW // 新询盘（未处理）
  CONTACTED // 已联系客户
  QUOTED // 已报价
  CLOSED // 已关闭
}

enum MediaProvider {
  LOCAL // 本地/服务器磁盘（开发期）
  TENCENT_COS // 预留：腾讯云对象存储（Phase 2+ 接入，本阶段不调用）
}

// ---------- 模型 ----------

// 后台管理员（未来内容管理后台登录账号）
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // bcrypt 等哈希，禁止明文
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  blogPosts BlogPost[]

  @@map("admin_users")
}

// 产品分类（支持一级父子结构，为未来多级预留 self-relation）
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // SEO URL
  description String?
  parentId    String? // 未来多级分类：自关联
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

// 产品（Phase 3.5 扩展为可承载 CMS 详情内容的产品实体）
//
// 设计约束（百灵木业是 B2B 制造商，不是电商）：
//   · 不含 price / stock / sku / cart / payment 等电商字段
//   · 不绑定任何图片存储服务（图片只存 URL，未来可指向 COS/CDN）
//   · specifications 采用 jsonb 键值对，便于 CMS 侧自由扩展
model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique // SEO URL，详情页 /products/[slug]
  shortDescription String? // 列表页短描述（卡片展示）
  description      String        @db.Text // 详情页完整描述
  categoryId       String
  material         String? // 材质说明
  application      String? // 应用场景
  specifications   Json? // 规格参数：{ "厚度": "18mm", ... }
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) // 首页/列表页精选
  seoTitle         String? // SEO 标题，空则回落 name
  seoDescription   String? // SEO 描述，空则回落 shortDescription

  category  Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  rfqs      Rfq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

// 产品图片（一对多）。仅登记 URL 与元数据，不耦合具体存储服务；
// provider/上传抽象在 CMS 阶段实现（见 MediaAsset）。
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String // 对外访问地址（未来为 COS + CDN 域名）
  altText   String? // 图片替代文本，SEO / 可访问性需要
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false) // 主图（列表卡片 / OG image）

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

// RFQ 询盘（B2B 核心业务链路：海外采购商提交询价 → 后台跟进报价）
//
// 设计约束（百灵木业是 B2B 制造商，不是电商）：
//   · 不含 price / payment / order / cart 等交易字段
//   · 只收集采购需求（规格、数量、目标市场），报价由业务在邮件中完成
//   · attachmentUrl 仅登记地址，不绑定具体存储服务（未来可指向 COS / R2 / OSS）
//   · sourceIp / userAgent 仅用于风控与统计，不属于个人敏感信息
model Rfq {
  id            String    @id @default(cuid())
  name          String // 联系人姓名（必填）
  company       String // 公司名称（必填）
  email         String // 联系邮箱（必填）
  phone         String? // 电话（可选）
  country       String // 国家 / 地区（必填）
  productId     String? // 意向产品（可选，关联 Product）
  productName   String? // 产品名称快照（产品被删除后仍可追溯）
  message       String    @db.Text // 采购需求（必填）
  quantity      String? // 预估数量（可选，自由文本，如 "1 x 20GP"）
  attachmentUrl String? // 附件地址（可选，本阶段仅登记）
  status        RfqStatus @default(NEW)

  sourceIp  String? // 风控：提交来源 IP
  userAgent String? // 风控：提交来源 UA

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("rfqs")
}

// 博客文章（内容营销 / SEO）
model BlogPost {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String     @db.Text
  coverImageUrl  String? // 指向 MediaAsset.url 或 COS/CDN 地址
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  authorId       String?

  author AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

// 媒体资源（产品图片等）。Phase 1 只登记 URL 与元数据；
// provider 字段为腾讯云 COS 预留（Phase 2+ 再实现上传抽象层）。
model MediaAsset {
  id         String        @id @default(cuid())
  fileName   String
  storageKey String // 存储路径/对象键
  url        String // 对外访问地址（未来为 COS + CDN 域名）
  mimeType   String
  size       Int // 字节
  altText    String? // 图片替代文本，SEO 需要
  provider   MediaProvider @default(LOCAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@map("media_assets")
}
