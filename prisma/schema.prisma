// Bailing Wooden B2B Website - Prisma Schema
// Phase 1 仅建立基础数据模型，不包含业务数据种子。
// 所有数据库变更必须通过 prisma migrate 管理，禁止手改数据库结构。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

enum AdminRole {
  ADMIN // 超级管理员
  EDITOR // 内容编辑
}

enum ProductStatus {
  DRAFT // 草稿（未发布；公开 API 不可见）
  PUBLISHED // 已发布（线上版本）
  UNPUBLISHED // 已取消发布（内容保留，可重新发布；公开 API 不可见）
  ARCHIVED // 已归档（历史值，语义等同 UNPUBLISHED，保留以兼容存量数据）
}

// 博客文章发布状态（Phase 4.7 起与 ProductStatus/ContentStatus 统一为三态）：
//   DRAFT → PUBLISHED → ARCHIVED
// 公开 API 只返回 PUBLISHED；ARCHIVED 与 DRAFT 一律不可见（且不泄漏存在性）。
enum PostStatus {
  DRAFT // 草稿（不进公开 API）
  PUBLISHED // 已发布（可被公开 API 读取）
  UNPUBLISHED // 已取消发布（保留内容与历史，可重新发布）
  ARCHIVED // 已归档（历史值，语义等同 UNPUBLISHED）
}

// RFQ（Request For Quotation）状态流转：新询盘 → 已联系 → 已报价 → 已关闭
enum RfqStatus {
  NEW // 新询盘（未处理）
  CONTACTED // 已联系客户
  QUOTED // 已报价
  CLOSED // 已关闭
}

enum MediaProvider {
  LOCAL // 本地/服务器磁盘（开发期）
  TENCENT_COS // 预留：腾讯云对象存储（Phase 2+ 接入，本阶段不调用）
}

// ---------- 模型 ----------

// 后台管理员（未来内容管理后台登录账号）
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // bcrypt 等哈希，禁止明文
  name         String
  jobTitle     String? // 岗位名称（Phase 4.6）
  role         AdminRole @default(EDITOR) // 兼容旧枚举；新逻辑以 AdminUserRole 为准
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  blogPosts BlogPost[]

  // Phase 4.6：多角色、联系方式、询盘分配相关
  userRoles       AdminUserRole[]
  contact         EmployeeContact?
  leadPlanItems   LeadDistributionItem[]
  leadAssignments LeadAssignment[]
  assignedRfqs    Rfq[]                  @relation("RfqAssignee")

  // Phase 5.1 / 5.2：样品持有人 / 授权 / 申请，订单业务员 / 附件上传人
  ownedSamples     Sample[]         @relation("SampleOwner")
  grantedSamples   SampleGrant[]    @relation("SampleGrantee")
  sampleRequests   SampleRequest[]  @relation("SampleRequester")
  orders           Order[]          @relation("OrderSalesperson")
  orderUploads     OrderAttachment[] @relation("OrderAttachmentUploader")
  inventoryItems   InventoryItem[]  @relation("InventoryCreator")

  @@index([isActive])
  @@index([role])
  @@map("admin_users")
}

// 产品分类（支持一级父子结构，为未来多级预留 self-relation）
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // SEO URL
  description String?
  parentId    String? // 未来多级分类：自关联
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

// 产品（Phase 3.5 扩展为可承载 CMS 详情内容的产品实体）
//
// 设计约束（百灵木业是 B2B 制造商，不是电商）：
//   · 不含 price / stock / sku / cart / payment 等电商字段
//   · 不绑定任何图片存储服务（图片只存 URL，未来可指向 COS/CDN）
//   · specifications 采用 jsonb 键值对，便于 CMS 侧自由扩展
model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique // SEO URL，详情页 /products/[slug]
  shortDescription String? // 列表页短描述（卡片展示）
  description      String        @db.Text // 详情页完整描述
  categoryId       String
  material         String? // 材质说明
  application      String? // 应用场景（公开站展示，向后兼容单值）
  applications     Json? // 应用标签数组（Phase 4.2 CMS 管理），如 ["Furniture","Construction"]
  specifications   Json? // 规格参数：{ "厚度": "18mm", ... }
  status           ProductStatus @default(DRAFT)
  version          Int           @default(0) // 乐观锁：并发保存/发布冲突检测
  publishedVersion Int           @default(0) // 当前线上版本号（0 = 从未发布）
  isFeatured       Boolean       @default(false) // 首页/列表页精选
  seoTitle         String? // SEO 标题，空则回落 name
  seoDescription   String? // SEO 描述，空则回落 shortDescription

  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  rfqs             Rfq[]
  // Phase 4.5：被哪些应用场景引用。
  // 注意命名——Product.applications（Json 字符串标签，Phase 4.2 遗留）已占用该字段名，
  // 关系侧故命名为 applicationLinks，避免与之混淆。
  applicationLinks ApplicationProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

// 产品图片（一对多）。仅登记 URL 与元数据，不耦合具体存储服务；
// provider/上传抽象在 CMS 阶段实现（见 MediaAsset）。
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String // 对外访问地址（未来为 COS + CDN 域名）
  altText   String? // 图片替代文本，SEO / 可访问性需要
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false) // 主图（列表卡片 / OG image）

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

// RFQ 询盘（B2B 核心业务链路：海外采购商提交询价 → 后台跟进报价）
//
// 设计约束（百灵木业是 B2B 制造商，不是电商）：
//   · 不含 price / payment / order / cart 等交易字段
//   · 只收集采购需求（规格、数量、目标市场），报价由业务在邮件中完成
//   · attachmentUrl 仅登记地址，不绑定具体存储服务（未来可指向 COS / R2 / OSS）
//   · sourceIp / userAgent 仅用于风控与统计，不属于个人敏感信息
model Rfq {
  id            String    @id @default(cuid())
  name          String // 联系人姓名（必填）
  company       String // 公司名称（必填）
  email         String // 联系邮箱（必填）
  phone         String? // 电话（可选）
  country       String // 国家 / 地区（必填）
  productId     String? // 意向产品（可选，关联 Product）
  productName   String? // 产品名称快照（产品被删除后仍可追溯）
  message       String    @db.Text // 采购需求（必填）
  quantity      String? // 预估数量（可选，自由文本，如 "1 x 20GP"）
  attachmentUrl String? // 附件地址（可选，本阶段仅登记）
  status        RfqStatus @default(NEW)

  // Phase 4.6：询盘负责人（自动轮询分配）
  assigneeId String?
  assignedAt DateTime?
  assignee   AdminUser? @relation("RfqAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  sourceIp  String? // 风控：提交来源 IP
  userAgent String? // 风控：提交来源 UA

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  assignments LeadAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([assigneeId])
  @@map("rfqs")
}

// 博客分类（Phase 4.4 内容营销 / SEO，支持排序与禁用）
model BlogCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // SEO URL：/blog/category/[slug]
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("blog_categories")
}

// 博客标签（Phase 4.4）。标签仅登记名称与 slug，不做排序/禁用。
model BlogTag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts BlogPostTag[]

  createdAt DateTime @default(now())

  @@map("blog_tags")
}

// 博客文章（内容营销 / SEO）
//
// 设计约束：
//   · 不自行存储图片——封面经 coverMediaId 关联 MediaAsset，业务模块禁止直接操作文件系统
//   · coverImageUrl 为 Phase 1 预留字段，保留作"快照/外链"兼容（如历史 COS/CDN 地址）；
//     新建内容以 coverMediaId 为准，写入时同步回填 coverImageUrl 便于公开站直接渲染
//   · SEO 字段（seoTitle/seoDescription/seoKeywords/canonicalUrl）供 Google/Bing/Sitemap 消费
//   · OG / Twitter Card 字段为预留：本阶段仅存储与透出，不接入第三方校验
model BlogPost {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  excerpt          String?
  content          String     @db.Text // 富文本（HTML），写入前经 sanitize 过滤
  coverImageUrl    String? // 封面地址快照（可由 coverMedia 回填；兼容历史外链）
  coverMediaId     String? // 封面媒体（关联 MediaAsset，Phase 4.3 Media Library）
  categoryId       String? // 所属博客分类
  status           PostStatus @default(DRAFT)
  version          Int        @default(0) // 乐观锁：并发保存/发布冲突检测
  publishedVersion Int        @default(0) // 当前线上版本号（0 = 从未发布）
  featured         Boolean    @default(false) // 精选（首页 / 推荐位）
  publishedAt      DateTime?
  authorId         String?

  // SEO
  seoTitle       String? // SEO 标题，空则回落 title
  seoDescription String? // SEO 描述，空则回落 excerpt
  seoKeywords    String? // 关键词，逗号分隔
  canonicalUrl   String? // 规范链接（跨站转载时指向原文）

  // Open Graph（预留：存储 + 透出，不接第三方校验）
  ogTitle       String?
  ogDescription String?
  ogImage       String?

  // Twitter Card（预留）
  twitterTitle       String?
  twitterDescription String?

  author     AdminUser?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverMedia MediaAsset?   @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  tags       BlogPostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([coverMediaId])
  @@map("blog_posts")
}

// 博客文章 ↔ 标签 多对多连接模型（显式 join，便于未来加排序/权重字段）
model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

// 媒体资源（Phase 4.3 Media Library：Storage Adapter 模式落地）。
//
// 设计原则（业务模块 → MediaService → StorageProvider → Local / COS / CDN）：
//   · 业务模块（Product 等）禁止直接操作文件系统，一律经 MediaService → StorageProvider
//   · storageKey 为存储系统内的对象键（本地为相对路径、未来 COS 为 Object Key），
//     统一形如 media/<YYYY>/<MM>/<uuid>.<ext>（见 API-CONVENTIONS URL 策略）
//   · url 为当前访问地址（本地 /uploads/media/**），由 StorageProvider 按 provider 生成；
//     未来切换 COS + CDN 只改 Provider 配置，业务数据不动
//   · provider 自 Phase 1 预留（LOCAL / COS），当前仅 LOCAL 落地
//   · createdBy 为上传管理员 ID（AdminUser.id）；不建外键——管理员注销
//     不应级联删除媒体资产，历史归属信息保留即可
model MediaAsset {
  id           String        @id @default(cuid())
  filename     String // 存储文件名（UUID + 扩展名，防路径穿越）
  originalName String // 客户端原始文件名（仅展示，不参与任何路径拼接）
  storageKey   String        @unique // 存储对象键：media/<YYYY>/<MM>/<uuid>.<ext>
  url          String // 对外访问地址（StorageProvider 生成；未来为 COS + CDN 域名）
  mimeType     String // MIME（白名单：image/jpeg|png|webp|avif）
  size         Int // 字节数
  width        Int? // 像素宽（可解析时写入，解析失败为 null）
  height       Int? // 像素高
  altText      String? // 图片替代文本，SEO 需要
  // Phase 5.0：图片 SEO 元数据（alt 已存在于上方；此处补齐 title/caption/description）
  title        String? // 图片标题（<img title> / 图库展示）
  caption      String? // 图注（前台图片说明）
  description  String? // 图片详细描述（SEO / 无障碍）
  provider     MediaProvider @default(LOCAL) // 存储提供方（Storage Adapter 选择）
  category     MediaCategory @default(IMAGE) // 资源分类（IMAGE / DOCUMENT）
  createdBy    String // 上传管理员 ID（AdminUser.id）

  blogCovers BlogPost[] // 被博客文章引作封面的反向关系（引用检查用）

  // Phase 4.5 企业内容 CMS 的反向关系（删除保护：被引用时不允许删除媒体）
  factoryCovers     FactorySection[] @relation("FactorySectionCover")
  factoryImages     FactoryImage[]   @relation("FactoryImageMedia")
  qualityRecords    QualityRecord[]  @relation("QualityRecordMedia")
  applicationCovers Application[]    @relation("ApplicationCover")

  // Phase 4.7 站点结构化内容分区的媒体引用（删除保护同覆盖）
  siteSectionMedia SiteSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([category])
  @@index([createdAt])
  @@index([createdBy])
  @@map("media_assets")
}

// 媒体分类（IMAGE 为图片，DOCUMENT 为 PDF 等文档）
// Phase 4.5 起 DOCUMENT 正式启用：Quality CMS 的认证证书 / 检测报告以 PDF 承载。
enum MediaCategory {
  IMAGE
  DOCUMENT
}

// ---------- Phase 4.5：企业内容 CMS（Factory / Quality / Applications） ----------

// 内容发布状态（Factory / Quality / Applications 共用）
//
// Phase 4.7 统一为全站三态（与 ProductStatus 对齐）：
//   DRAFT → PUBLISHED → ARCHIVED
// 公开 API 只返回 PUBLISHED；ARCHIVED / DRAFT 一律不可见。
enum ContentStatus {
  DRAFT // 草稿（不进公开 API）
  PUBLISHED // 已发布（可被公开 API 读取）
  UNPUBLISHED // 已取消发布（保留内容与历史，可重新发布）
  ARCHIVED // 已归档（历史值，语义等同 UNPUBLISHED）
}

// 工厂内容分区类型（Factory CMS）
enum FactorySectionType {
  OVERVIEW // 工厂介绍
  FACILITY // 厂房及生产设施
  EQUIPMENT // 生产设备
  PRODUCTION // 生产流程
  LOADING // 装柜及装车
  EXHIBITION // 参展记录
}

// 质量记录类型（Quality CMS）
enum QualityRecordType {
  CERTIFICATION // 体系认证
  TEST_REPORT // 检测报告
  QUALITY_CONTROL // 质量控制说明
  STANDARD // 执行标准
}

// 工厂实力内容分区（Factory CMS 主体模型）
//
// 设计约束：
//   · 一个分区由 sectionType 归类（工厂介绍 / 厂房 / 设备 / 生产流程 / 装柜 / 参展）
//   · coverMediaId 关联 Media Library，不自行存文件；coverImageUrl 为 URL 快照兼容外链
//   · 图集经 FactoryImage 关联（一对多，可排序、可设 ALT），删除分区时级联解绑
//   · SEO 三件套（slug/seoTitle/seoDescription）供公开详情页 /sitemap 消费
model FactorySection {
  id            String             @id @default(cuid())
  title         String
  slug          String             @unique // SEO URL，公开详情页 /factory/[slug]
  sectionType   FactorySectionType
  summary       String?
  content       String?            @db.Text // 富文本（HTML），写入前经白名单净化
  coverMediaId  String? // 封面媒体（Media Library）
  coverImageUrl String? // 封面地址快照（由 coverMedia 回填，兼容历史外链）

  status           ContentStatus @default(DRAFT)
  version          Int           @default(0) // 乐观锁：并发保存/发布冲突检测
  publishedVersion Int           @default(0) // 当前线上版本号（0 = 从未发布）
  sortOrder        Int           @default(0)
  publishedAt      DateTime?

  seoTitle       String?
  seoDescription String?

  coverMedia  MediaAsset?         @relation("FactorySectionCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  images      FactoryImage[]
  exhibitions FactoryExhibition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sectionType])
  @@index([sortOrder])
  @@index([publishedAt])
  @@index([coverMediaId])
  @@map("factory_sections")
}

// 工厂图片（FactorySection 图库，一对多）
//
// 与 ProductImage 同构：仅登记 mediaId 与展示元数据，不复制文件。
// 删除分区 → 级联删除关联行（媒体资产本身保留，由引用检查兜底）。
model FactoryImage {
  id           String  @id @default(cuid())
  sectionId    String
  mediaId      String // 关联 Media Library 资产
  // 可选归属展会：为空表示该图属于分区图库；有值表示是该展会的照片
  exhibitionId String?
  altText      String?
  sortOrder    Int     @default(0)

  section    FactorySection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  exhibition FactoryExhibition? @relation("ExhibitionPhotos", fields: [exhibitionId], references: [id], onDelete: Cascade)
  media      MediaAsset         @relation("FactoryImageMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([sectionId])
  @@index([exhibitionId])
  @@index([mediaId])
  @@map("factory_images")
}

// 参展记录（Factory CMS 子模型）
//
// 独立模型而非塞进 JSON：展会有明确字段（名称/日期/地点）且需要照片关联，
// 结构化存储才能做前台排序、按时间展示与后续统计。
// Phase 4.5 不开发独立 Events CMS——本模型仅服务于工厂实力的参展展示。
model FactoryExhibition {
  id          String    @id @default(cuid())
  sectionId   String // 归属的工厂分区（通常 sectionType = EXHIBITION）
  name        String // 展会名称
  heldOn      DateTime? // 展会日期
  location    String? // 展会地点
  description String?   @db.Text
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true) // 是否在前台展示

  section FactorySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  photos  FactoryImage[] @relation("ExhibitionPhotos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([heldOn])
  @@map("factory_exhibitions")
}

// 质量记录（Quality CMS）
//
// 设计约束：
//   · recordType 区分体系认证 / 检测报告 / 质量控制说明 / 执行标准
//   · 证书编号、颁发日期、有效期**允许为空**——质量控制说明与执行标准
//     通常没有证书编号，不能强制要求（不虚构业务资料）
//   · mediaId 关联证书图片或 PDF（Media Library 的 DOCUMENT 类型）
//   · 公开 API 只输出 PUBLISHED 记录，草稿与停用内容不外露
model QualityRecord {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  recordType        QualityRecordType
  issuer            String? // 认证 / 检测机构
  certificateNumber String? // 证书编号（可空）
  issueDate         DateTime? // 颁发日期（可空）
  expiryDate        DateTime? // 到期日期（可空；空 ≠ 已过期）
  description       String?           @db.Text

  mediaId          String? // 证书图片 / PDF（Media Library）
  status           ContentStatus @default(DRAFT)
  version          Int           @default(0) // 乐观锁：并发保存/发布冲突检测
  publishedVersion Int           @default(0) // 当前线上版本号（0 = 从未发布）
  sortOrder        Int           @default(0)
  publishedAt      DateTime?

  seoTitle       String?
  seoDescription String?

  media MediaAsset? @relation("QualityRecordMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([recordType])
  @@index([sortOrder])
  @@index([publishedAt])
  @@index([mediaId])
  @@map("quality_records")
}

// 产品应用场景（Applications CMS）
//
// 设计约束：
//   · 与产品为**显式多对多**（ApplicationProduct），而非存产品名字符串——
//     字符串无法保证引用完整性，产品改名即失联
//   · coverMediaId 关联封面图，不自行存文件
//   · featured 用于前台推荐位 / 首页展示
model Application {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique // 公开详情页 /applications/[slug]
  summary       String?
  description   String? @db.Text
  coverMediaId  String?
  coverImageUrl String?

  status           ContentStatus @default(DRAFT)
  version          Int           @default(0) // 乐观锁：并发保存/发布冲突检测
  publishedVersion Int           @default(0) // 当前线上版本号（0 = 从未发布）
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  publishedAt      DateTime?

  seoTitle       String?
  seoDescription String?

  coverMedia MediaAsset?          @relation("ApplicationCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  products   ApplicationProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@index([publishedAt])
  @@index([coverMediaId])
  @@map("applications")
}

// 应用场景 ↔ 产品（显式多对多连接模型）
//
// 删除应用场景 → 级联删除关联行（**不删产品**）；
// 产品侧用 Restrict：产品若仍被应用场景引用，禁止直接删除产品，
// 由 Product 模块感知并给出明确提示（保证关系完整性）。
model ApplicationProduct {
  applicationId String
  productId     String
  sortOrder     Int    @default(0)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([applicationId, productId])
  @@index([productId])
  @@map("application_products")
}

// ==================== Phase 4.6：账号 / 角色权限 / 联系方式 / 询盘分配 ====================

// 角色状态：启用 / 停用
enum RoleStatus {
  ACTIVE // 启用
  DISABLED // 停用（不再生效，关联员工保留历史）
}

// 询盘轮询计划状态
enum LeadPlanStatus {
  ACTIVE // 生效中（倾斜分配进行中）
  COMPLETED // 已完成（所有目标达成）
  CLOSED // 已手动关闭
}

// 询盘分配来源：正常轮询 / 倾斜计划
enum LeadAssignmentSource {
  ROUND_ROBIN // 正常轮流分配
  PRIORITY_PLAN // 倾斜计划分配
}

// 自定义角色（Phase 4.6 RBAC）
//
// 与旧枚举 AdminRole 共存（兼容迁移期）：
//   · key 为稳定英文标识（如 SUPER_ADMIN / SALES_MANAGER），全局唯一
//   · isSystem=true 的角色受保护，不允许删除 / 停用 / 改 key
//   · 权限通过 RolePermission 关联到 Permission 定义
model Role {
  id          String     @id @default(cuid())
  key         String     @unique // 稳定英文标识，如 SUPER_ADMIN
  name        String // 展示名称（中文），如 超级管理员
  description String? // 角色说明
  status      RoleStatus @default(ACTIVE)
  isSystem    Boolean    @default(false) // 系统内置角色（受保护）
  sortOrder   Int        @default(0)

  rolePermissions RolePermission[]
  userRoles       AdminUserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@map("roles")
}

// 权限定义（Phase 4.6）
//
// 权限由代码中的注册表（PERMISSION_CATALOG）声明并 seed 入库，
// 数据库仅作存储与关联，**授权判定以服务端代码注册表 + 库中关联为准**。
// key 为稳定英文标识（如 accounts.read），不允许运行时随意新增。
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // 如 accounts.read
  module      String // 所属模块分组，如 accounts / roles / contacts / lead_distribution
  action      String // 动作，如 read / create / update / disable / manage
  name        String // 展示名称（中文）
  description String? // 权限说明
  isNav       Boolean @default(false) // 是否为导航权限（推导侧边栏菜单可见性）
  sortOrder   Int     @default(0)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())

  @@index([module])
  @@index([isNav])
  @@map("permissions")
}

// 角色 ↔ 权限 关联
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// 管理员 ↔ 角色 关联（多角色）
//
// 保留 AdminUser.role 枚举字段作为兼容兜底（旧 JWT / 旧逻辑），
// 新逻辑以本表分配的多个角色之并集判定权限。
model AdminUserRole {
  adminUserId String
  roleId      String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

// 员工对外销售联系方式（Phase 4.6）
//
// 与 AdminUser 一一对应（adminUserId 唯一）：联系方式必须挂在真实员工账号上，
// 不允许创建与账号脱节的虚假员工。
// 登录邮箱（AdminUser.email）与对外展示邮箱（displayEmail）严格区分。
model EmployeeContact {
  id            String  @id @default(cuid())
  adminUserId   String  @unique // 关联员工账号（一对一）
  displayName   String // 对外显示姓名
  jobTitle      String? // 销售职务
  displayEmail  String? // 对外展示工作邮箱（可与登录邮箱不同）
  whatsapp      String? // WhatsApp 号码（含国际区号，如 +8613800138000）
  showOnSite    Boolean @default(false) // 是否展示在网站前台
  isLeadContact Boolean @default(false) // 是否作为询盘联系人（参与分配）
  sortOrder     Int     @default(0) // 展示顺序
  internalNote  String? // 内部备注（仅供后台，绝不出现在公开 API）

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showOnSite])
  @@index([isLeadContact])
  @@index([sortOrder])
  @@map("employee_contacts")
}

// 询盘轮询计划（Phase 4.6）
//
// 两种形态：
//   · 默认 Round Robin 无需持久化计划（按员工队列顺序循环）
//   · 倾斜计划（PRIORITY）持久化本表：指定若干员工在目标数量内优先接单
// 手动关闭（CLOSED）后进入冷却窗口，冷却时长由 closedAt + cooldownSeconds 决定；
// 冷却结束后自动恢复倾斜（或按管理员设置）。
model LeadDistributionPlan {
  id              String         @id @default(cuid())
  name            String // 计划名称
  status          LeadPlanStatus @default(ACTIVE)
  mode            String         @default("PRIORITY") // 分配模式标识（PRIORITY 倾斜）
  startAt         DateTime       @default(now()) // 生效时间
  endAt           DateTime? // 计划截止（可空表示按目标数量结束）
  totalTarget     Int            @default(0) // 计划目标总量（各项之和的快照）
  cooldownSeconds Int            @default(0) // 手动关闭后的冷却秒数（0=需管理员手动恢复）
  closedAt        DateTime? // 手动关闭时间
  resumeAt        DateTime? // 预计自动恢复时间（closedAt + cooldown）
  closedBy        String? // 关闭操作者 AdminUser.id（不建外键，保留历史）
  createdBy       String? // 创建者 AdminUser.id

  items       LeadDistributionItem[]
  assignments LeadAssignment[]
  logs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("lead_distribution_plans")
}

// 倾斜计划条目：某员工的目标数量与已分配数量
model LeadDistributionItem {
  id            String @id @default(cuid())
  planId        String
  adminUserId   String // 倾斜员工（AdminUser.id）
  targetCount   Int    @default(0) // 目标数量
  assignedCount Int    @default(0) // 已成功分配数量
  sortOrder     Int    @default(0)

  plan      LeadDistributionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  adminUser AdminUser            @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, adminUserId])
  @@index([planId])
  @@index([adminUserId])
  @@map("lead_distribution_items")
}

// 正常轮询指针状态（Phase 4.6，单例表）。
// 独立成表而非从分配明细推算：队列成员增减时指针仍能确定性地推进，
// 「下一位是谁」随时可复算、可校验，不依赖历史记录的完整性。
model LeadRoundRobinState {
  id             String   @id @default(cuid())
  lastAssigneeId String? // 最近一次正常轮询的承接人（null = 尚未分配过）
  lastIndex      Int      @default(-1) // 承接人在当时队列中的序号（-1 = 尚未分配）
  cycleCount     Int      @default(0) // 正常轮询累计分配次数（统计用，不参与指针计算）
  updatedAt      DateTime @updatedAt

  @@map("lead_round_robin_state")
}

// 询盘分配记录（每次分配落库，供历史与审计）
model LeadAssignment {
  id              String               @id @default(cuid())
  rfqId           String
  assigneeId      String // 接收员工 AdminUser.id
  source          LeadAssignmentSource @default(ROUND_ROBIN)
  roundRobinIndex Int? // 正常轮询时的队列位置（便于核对顺序）
  planId          String? // 若来自倾斜计划，记录计划 ID

  rfq      Rfq                   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  assignee AdminUser             @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  plan     LeadDistributionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rfqId])
  @@index([assigneeId])
  @@index([source])
  @@index([createdAt])
  @@map("lead_assignments")
}

// 操作审计日志（角色 / 权限 / 账号 / 计划等关键变更）
//
// 记录操作者、对象类型与 ID、变更前后差异（JSON）、时间。
// 不记录任何口令或令牌。
model AuditLog {
  id         String  @id @default(cuid())
  actorId    String? // 操作者 AdminUser.id（系统操作可为空）
  actorEmail String? // 操作者邮箱快照（便于历史追溯，账号删除后仍可读）
  action     String // 动作标识，如 role.update / account.disable / plan.close
  targetType String // 对象类型，如 role / account / plan / contact
  targetId   String? // 对象 ID
  diff       Json? // 变更前后差异
  summary    String? // 人类可读摘要（中文）

  planId String? // 若与计划相关，便于按计划查询
  plan   LeadDistributionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Phase 4.7：站点结构化内容（首页 / 关于我们 / 联系页 + 导航） ----------

// 站点页面标识。当前仅三个静态页面允许 CMS 结构化内容。
// 产品 / 博客 / 工厂 / 质量 / 应用各有专门模型，不走本表。
enum SitePage {
  HOME // 首页
  ABOUT // 关于我们
  CONTACT // 联系页
}

// 站内导航位置
enum NavLocation {
  HEADER // 页眉主导航
  FOOTER // 页脚链接组
}

// 站点页面的结构化内容分区（首页 / 关于我们 / 联系页）。
//
// 设计约束（硬性，对应任务书「禁止页面构建器」）：
//   · **没有** block 流 / 任意 HTML / 自由拖拽布局；
//     每个 sectionKey 对应一组固定语义字段（标题 / 副标题 / 正文 / 媒体 / CTA / 统计项）
//   · sectionKey 在同一页面内唯一（如 home.hero / home.stats / about.intro）
//   · 媒体引用统一走 MediaAsset（mediaId 外键 → 删除保护自动覆盖）
//   · stats 为结构化统计项 [{label, value}]，DTO 白名单校验，绝不承载富文本
//   · ctaUrl 必须通过 URL 安全校验（同 NavItem，见 site-url.ts）
model SiteSection {
  id               String        @id @default(cuid())
  page             SitePage
  sectionKey       String // 页内唯一标识，如 home.hero / about.intro
  eyebrow          String? // 小节眉题（如 Capabilities / Products）
  title            String?
  subtitle         String?
  body             String? // 受限正文（编辑器约束，不承载脚本）
  mediaId          String? // 关联媒体库（封面 / 配图）
  ctaLabel         String? // 行动按钮文案
  ctaUrl           String? // 行动按钮链接（经 URL 安全校验）
  items            Json? // 结构化卡片数组 [{title, description?, href?}]，DTO 白名单校验
  stats            Json? // 结构化统计项 [{label, value}]
  status           ContentStatus @default(DRAFT)
  version          Int           @default(0) // 乐观锁：并发保存/发布冲突检测
  publishedVersion Int           @default(0) // 当前线上版本号（0 = 从未发布）
  sortOrder        Int           @default(0)
  createdBy        String // 操作管理员 AdminUser.id
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?

  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([page, sectionKey])
  @@index([status])
  @@index([page, sortOrder])
  @@map("site_sections")
}

// 站内导航项（页眉 / 页脚），由 CMS 驱动，替换前台硬编码链接。
//
// 安全约束：
//   · url 必须经 URL 安全校验（site-url.ts）：仅允许①站内相对路径（/xxx，
//     不以 // 开头，防 protocol-relative 外跳）②https 白名单外链；
//     拒绝 javascript: / data: / http: 混合内容等一切危险协议
//   · openInNewTab=true 的前台必须同时 rel="noopener noreferrer"
model NavItem {
  id           String      @id @default(cuid())
  location     NavLocation
  label        String
  url          String // 经安全校验的相对路径或 https 外链
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  openInNewTab Boolean     @default(false)
  createdBy    String // 操作管理员 AdminUser.id
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([location, isActive, sortOrder])
  @@map("nav_items")
}

// ==================== Phase 5.0：全站 SEO 基础设施 ====================
//
// 设计原则（任务书第四节「SEO 数据与业务内容模型解耦」）：
//   · SEO 元数据集中在一张 SeoProfile 表，按 (entityType, entityId) 唯一，
//     产品 / 博客 / 页面 / 分类等所有可索引实体共用一套字段与一套解析逻辑，
//     不在各业务模型上重复长出一片 SEO 字段；
//   · 业务模型上既有的 legacy SEO 字段（Product.seoTitle 等）保持只读兼容，
//     新数据一律写入 SeoProfile；解析时 SeoProfile 优先；
//   · 静态页面用稳定 key 作 entityId（如 home / about / contact），
//     动态实体用业务主键 cuid，实体删除后 profile 行随业务流程清理。

// SEO 实体类型（统一 SEO 表的解耦键）
enum SeoEntityType {
  PAGE // 静态页面（entityId = 稳定 key：home / products / applications / factory / quality / about / contact / blog）
  PRODUCT // 产品（entityId = Product.id）
  PRODUCT_CATEGORY // 产品分类（entityId = Category.id）
  BLOG_POST // 博客文章（entityId = BlogPost.id）
  BLOG_CATEGORY // 博客分类（entityId = BlogCategory.id）
  APPLICATION // 应用场景（entityId = Application.id）
  FACTORY_SECTION // 工厂分区（entityId = FactorySection.id）
  QUALITY_RECORD // 质量记录（entityId = QualityRecord.id）
}

// Schema.org 结构化数据类型（后台按页面类型选择，默认 NONE 不输出）
enum SchemaType {
  NONE
  WEB_PAGE
  PRODUCT
  ARTICLE
  FAQ_PAGE
}

// SEO 健康状态（Audit 引擎按分数归档，人工只读）
enum SeoStatus {
  UNAUDITED // 尚未审计
  GOOD // 90–100 Excellent
  NEEDS_IMPROVEMENT // 50–89 Needs Improvement
  POOR // 0–49 Poor
}

// 统一 SEO 档案（Phase 5.0）
//
// 字段与任务书 4.1 节逐条对应：title / metaTitle / metaDescription / canonicalUrl /
// robotsIndex / robotsFollow / focusKeyword / keywords / og* / twitter* /
// schemaType / schemaData + 审计结果（seoScore / seoStatus / lastAuditAt）。
model SeoProfile {
  id         String        @id @default(cuid())
  entityType SeoEntityType
  entityId   String // 动态实体为 cuid；静态页面为稳定 key（如 about）
  entityName String? // 实体名称快照（列表展示，实体改名后仍可读）
  routePath  String? // 前台路由（如 /products/abc；静态页为固定路径）

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean @default(true) // 默认 index
  robotsFollow    Boolean @default(true) // 默认 follow
  focusKeyword    String? // 焦点关键词（仅 SEO 分析参考，禁止堆砌）
  keywords        String? // 逗号分隔（内部管理；不作为主要 SEO 机制）

  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?

  schemaType SchemaType @default(NONE)
  schemaData Json? // 附加结构化数据（如 FAQ 条目）；写入前后端双重白名单校验

  relatedData Json? // 内联管理：{ products?: [slug], posts?: [slug], applications?: [slug] }

  // Audit 结果（仅 SEO Audit 引擎写入，管理员只读）
  seoScore    Int?
  seoStatus   SeoStatus @default(UNAUDITED)
  lastAuditAt DateTime?

  updatedById String? // 最后修改人 AdminUser.id（不建外键，保留历史）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([seoStatus])
  @@map("seo_profiles")
}

// SEO 全局设置（单例表，id 固定为 'global'）
//
// 对应任务书十九~二十节 + 三十七节（站长工具预留）。
// 公司信息字段只存运营确认过的数据，**严禁虚构**；未填空 = 前台不输出。
model SeoSettings {
  id String @id @default("global")

  siteName            String  @default("Bailing Wooden")
  siteTitle           String? // 站点标题（缺省 siteName）
  siteDescription     String? // 站点默认描述
  defaultOgImage      String? // 默认 OG 图
  defaultTwitterImage String? // 默认 Twitter 图（缺省回落 defaultOgImage）
  canonicalDomain     String? // https://bailingwooden.com（robots sitemap / canonical 基准）

  // 标题模板（%title% 占位符；空串按系统默认）
  pageTitleTemplate     String @default("%title% | Bailing Wooden")
  productTitleTemplate  String @default("%title% | Bailing Wooden")
  blogTitleTemplate     String @default("%title% | Bailing Wooden")
  categoryTitleTemplate String @default("%title% | Bailing Wooden")

  // 公司信息（Organization / LocalBusiness Schema 消费；不虚构）
  companyName    String?
  companyLogo    String?
  companyWebsite String?
  companyEmail   String?
  companyPhone   String?
  companyAddress String?
  companyCountry String?

  // Social（允许为空）
  linkedin  String?
  facebook  String?
  instagram String?
  youtube   String?
  whatsapp  String?

  // 站长工具（允许为空；未配置时前台不输出空标签）
  googleSiteVerification String? // <meta name="google-site-verification">
  googleAnalyticsId      String? // GA Measurement ID（仅配置能力，不强制加载）
  googleTagManagerId     String? // GTM ID（同上）

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
}

// SEO 重定向（任务书二十八节）
//
// 安全约束（后端强制）：
//   · sourcePath 必须是站内相对路径（/xxx，不允许 // 开头与外部 URL）；
//   · targetPath 允许站内相对路径或 http(s) 绝对 URL，禁止 javascript:/data: 等危险协议；
//   · 禁止自指向（source === target，归一化后比较）；
//   · 禁止成环（source → target 链条不得回到 source 或形成链式环）。
model SeoRedirect {
  id         String  @id @default(cuid())
  sourcePath String  @unique // 站内路径，如 /old-product-page
  targetPath String // 站内路径或 https 绝对地址
  statusCode Int     @default(301) // 301（默认，永久）/ 302（临时）
  isActive   Boolean @default(true)
  note       String? // 迁移备注
  hits       Int     @default(0) // 命中次数（middleware 递增，仅统计）

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("seo_redirects")
}

// SEO 审计记录（任务书三十节；最近一次可供 Dashboard / 列表页展示）
model SeoAuditRun {
  id          String   @id @default(cuid())
  summary     Json // { total, passed, warnings, errors, critical }
  issues      Json // 问题明细 [{severity, check, entityType, entityId, routePath, message, suggestion}]
  triggerType String   @default("MANUAL") // MANUAL（本阶段仅手动触发；Audit 只读，不自动修复）
  durationMs  Int      @default(0)
  createdById String? // 触发人 AdminUser.id
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("seo_audit_runs")
}

// ==================== Phase 5.1：样品管理 ====================
//
// 设计约束（任务书 Phase 5.1）：
//   · 单仓库：不建 warehouse 实体，location 为自由文本存放位置
//   · 持有人 = 创建者（后端从会话确定，不接受前端传入）
//   · 业务三态：IN_STOCK 库中 / REQUEST_OUT 申请出库 / REJECTED 已拒绝；
//     OUT 为系统内部归档态（同意出库后软移除，不出现在业务列表）
//   · 同一样品同一时间只允许一个 PENDING 申请（迁移中用部分唯一索引保证）
//   · 出库（归档）不级联删除申请与审计记录

// 样品状态
enum SampleStatus {
  IN_STOCK // 库中
  REQUEST_OUT // 申请出库（存在待审批申请）
  REJECTED // 已拒绝（最近一次申请被拒，可重新申请）
  OUT // 已出库归档（业务列表不可见，仅管理员历史可查）
}

// 出库申请状态
enum SampleRequestStatus {
  PENDING // 待审批
  APPROVED // 已同意出库
  REJECTED // 已拒绝
  WITHDRAWN // 申请人已撤回
}

// 样品（单仓库）
model Sample {
  id         String       @id @default(cuid())
  code       String       @unique // 后端生成，形如 SP-20261017-XXXXXX
  name       String // 样品名称
  spec       String? // 产品型号或规格
  material   String? // 材质
  usage      String? // 用途
  quantity   Int // 数量（>=1，不允许负数）
  unit       String // 计量单位（片/张/块...）
  location   String // 存放位置（库区/货架/层位）
  remark     String? // 备注
  status     SampleStatus @default(IN_STOCK)
  ownerId    String // 持有人 AdminUser.id（创建人）
  archivedAt DateTime? // 同意出库时间

  owner    AdminUser       @relation("SampleOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  grants   SampleGrant[]
  requests SampleRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("samples")
}

// 样品查看授权（管理员 → 业务员，仅影响查看）
model SampleGrant {
  id          String    @id @default(cuid())
  sampleId    String
  granteeId   String // 被授权查看人 AdminUser.id
  grantedById String // 授权管理员 AdminUser.id
  revokedAt   DateTime? // 撤销时间（null = 授权有效）
  revokedById String?

  sample  Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  grantee AdminUser @relation("SampleGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sampleId])
  @@index([granteeId, revokedAt])
  @@map("sample_grants")
}

// 样品出库申请
model SampleRequest {
  id          String             @id @default(cuid())
  sampleId    String
  requesterId String // 申请人 AdminUser.id
  ownerId     String // 申请时样品持有人快照
  purpose     String             @db.Text // 申请说明 / 用途
  status      SampleRequestStatus @default(PENDING)
  decidedById String? // 审批人 AdminUser.id
  decidedAt   DateTime?
  withdrawnAt DateTime?

  sample    Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  requester AdminUser @relation("SampleRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleId, status])
  @@index([requesterId])
  @@index([ownerId, status])
  @@map("sample_requests")
}

// ==================== Phase 5.2：订单管理 ====================
//
// 设计约束（任务书 Phase 5.2）：
//   · 业务员 = 创建者（后端从会话确定）
//   · 金额 Decimal(14,2) + 币种枚举分列存储，不拼字符串
//   · 订单照片为业务附件：独立 OrderAttachment 表 + 独立 orders/ 存储命名空间，
//     与 MediaAsset / 媒体库完全隔离（媒体库查询天然不涉及本表）
//   · 文件不进静态可访问目录，一律经鉴权接口流式输出

// 订单币种
enum OrderCurrency {
  CNY // 人民币
  USD // 美元
  EUR // 欧元
}

// 订单
model Order {
  id            String        @id @default(cuid())
  code          String        @unique // 业务员手动填写，全系统唯一（trim 首尾；精确匹配、区分大小写）
  salespersonId String // 业务员 AdminUser.id（创建人，后端确定）
  customerName  String
  country       String
  requirement   String        @db.Text // 客户需求
  orderedAt     DateTime // 客户下单时间
  closedAt      DateTime? // 成交时间（可空）
  amount        Decimal       @db.Decimal(14, 2) // 金额（非负）
  currency      OrderCurrency
  note          String? // 备注

  salesperson AdminUser         @relation("OrderSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  attachments OrderAttachment[]
  inventoryItems InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salespersonId])
  @@index([orderedAt])
  @@index([createdAt])
  @@map("orders")
}

// 订单附件（照片；独立于 MediaAsset 的业务附件模型）
model OrderAttachment {
  id           String   @id @default(cuid())
  orderId      String? // 关联订单（null = 已上传待关联的临时态）
  originalName String
  storageKey   String   @unique // orders/<YYYY>/<MM>/<uuid>.<ext>
  mimeType     String // 仅允许 image/jpeg|png|webp
  size         Int
  uploadedById String // 上传人 AdminUser.id（关联时校验归属）

  order Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  owner AdminUser @relation("OrderAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([uploadedById, orderId])
  @@map("order_attachments")
}

// ============================================================
// Phase 5.3：库存管理（单仓库；可与订单关联，订单号从关联订单读取）
// ============================================================

model InventoryItem {
  id            String   @id @default(cuid())
  code          String   @unique // 库存编号，后端生成，形如 INV-20261018-XXXXXX
  productName   String // 产品名称
  productDetail String   @db.Text // 产品详情（规格/材质/型号等）
  quantity      Decimal  @db.Decimal(14, 3) // 数量（>=0，最多三位小数；不用浮点）
  unit          String // 计量单位（张/片/块/套/件/根/立方米/平方米/米/千克/吨）
  location      String // 存放位置（单仓库，手动输入）
  storedAt      DateTime // 存放日期
  orderId       String? // 关联订单（可空；订单号从该订单读取，不冗余副本）
  createdById   String // 创建人 AdminUser.id（后端从会话确定）

  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creator   AdminUser @relation("InventoryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([orderId])
  @@index([productName])
  @@index([storedAt])
  @@index([createdAt])
  @@map("inventory_items")
}

// ============================================================
// Phase 1：内容草稿与线上版本隔离
// ============================================================

/// 可发布内容实体类型（通用版本表按此区分实体）
enum ContentEntityType {
  PRODUCT
  BLOG_POST
  FACTORY_SECTION
  QUALITY_RECORD
  APPLICATION
  SITE_SECTION
}

/// 版本动作
enum ContentRevisionAction {
  PUBLISH // 发布（含首次发布、重新发布、恢复历史版本）
  UNPUBLISH // 取消发布
}

/// 编辑稿（每个实体最多一条）
///
/// 设计：实体行始终保存**当前线上版本**（从未发布时保存初始草稿）；
/// 已发布过（publishedVersion > 0）的实体再次保存时，写入本表而不触碰实体行。
/// payload 为该实体 Update DTO 的 JSON 快照，发布时按同一套映射应用。
model ContentDraft {
  id          String            @id @default(cuid())
  entityType  ContentEntityType
  entityId    String
  payload     Json // Update DTO 快照（只含编辑稿字段，不含 status）
  version     Int               @default(1) // 编辑稿版本（每次保存 +1）
  baseVersion Int               @default(0) // 创建草稿时实体行的 version
  updatedById String? // 最后保存人 AdminUser.id（不建外键，账号注销不删草稿）
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, updatedAt])
  @@map("content_drafts")
}

/// 发布历史（只追加，不覆盖）
///
/// 每条记录 = 一次成功发布后的**公开快照**（与公开 API 输出同构），
/// version 与实体 publishedVersion 对应，可据此恢复历史版本。
model ContentRevision {
  id            String                @id @default(cuid())
  entityType    ContentEntityType
  entityId      String
  version       Int // 发布版本号（实体维度递增）
  snapshot      Json // 发布时的公开内容快照
  action        ContentRevisionAction @default(PUBLISH)
  publishedById String? // 操作人 AdminUser.id
  publishedAt   DateTime              @default(now())
  note          String? // 备注（如「恢复自 v3」）

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, publishedAt])
  @@index([publishedAt])
  @@map("content_revisions")
}
