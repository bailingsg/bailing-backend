# ============================================================
# Bailing Wooden Backend - 环境变量模板
# 复制为 .env 后填入本地真实值；.env 不得提交 Git。
# ============================================================

# ---------- PostgreSQL（本地 Docker） ----------
POSTGRES_USER=bailing
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=bailingwooden
# 仅绑定本机地址，不暴露公网
POSTGRES_PORT=5432

# Prisma 连接串（本地 Docker PostgreSQL）
DATABASE_URL=postgresql://bailing:replace-with-a-strong-local-password@127.0.0.1:5432/bailingwooden?schema=public

# ---------- 后端服务 ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# ---------- CORS ----------
# 允许访问本 API 的前端 Origin，逗号分隔。生产环境必须显式列出，禁止使用 *
# 3000 = 主站 bailing-ui；3001 = 管理后台 bailing-admin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ---------- 后台接口保护（RFQ 管理） ----------
# 保护 GET /api/v1/rfq、GET /api/v1/rfq/:id、PATCH /api/v1/rfq/:id/status。
# 请求需携带请求头：X-Admin-Token: <值>
# 未配置时后台接口不鉴权（仅限本地开发）；**生产环境必须配置一个强随机值**。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ---------- 管理员认证（Phase 4.1，JWT） ----------
# JWT 签名密钥。仅来自环境变量，**代码不提供任何默认密钥**；
# 生产环境缺失或短于 32 字符将直接启动失败；开发环境缺失时使用进程级
# 随机密钥（服务重启后已签发令牌全部失效）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# access token 有效期。阶段约定：仅 access token（默认 12h），不实现 refresh token。
JWT_EXPIRES_IN=12h

# ---------- 默认管理员种子（npm run prisma:seed 读取） ----------
# 未配置时 seed 跳过默认管理员创建；口令只以 bcrypt 哈希入库，禁止明文。
# **生产环境必须使用强随机口令**，示例仅为占位。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_NAME=Administrator

# ---------- 产品图片本地存储（Phase 4.2） ----------
# 落库图片 URL 的对外基地址：本地默认 http://127.0.0.1:4000；
# 生产接入 CDN 后改为 CDN 域名（如 https://cdn.bailingwooden.com）。
# UPLOADS_BASE_URL=
# 单张图片大小上限（字节，默认 5MB）；允许 jpeg / png / webp / avif。
# UPLOAD_MAX_FILE_SIZE=5242880

# ---------- 媒体资源库存储适配器（Phase 4.3 / Phase 6.0） ----------
# 存储适配器开关：LOCAL（本地磁盘）| TENCENT_COS（对象存储 + CDN）。
# 业务代码只依赖 StorageProvider 接口，切换存储无需改业务逻辑。
# 选 TENCENT_COS 时下方 COS_* 必须齐全，否则**启动直接失败**（不会静默退化为本地）。
# STORAGE_PROVIDER=LOCAL
# 媒体文件**原始**大小上限（字节，默认 10MB）。
# 注意：图片会在服务端压缩（长边 2000px + 重编码），落库 size 是压缩后体积。
# 手机实拍大图建议放宽到 20MB（20971520），否则大图会先被体积校验拒绝、压缩无机会生效。
# MEDIA_MAX_FILE_SIZE=10485760
# 媒体存储根目录（LOCAL 模式；默认 <cwd>/uploads/media；可指向卷/数据盘）。
# MEDIA_UPLOAD_DIR=

# ---------- 腾讯云 COS + CDN（Phase 6.0，STORAGE_PROVIDER=TENCENT_COS 时必填） ----------
# 密钥必须是 **CAM 子用户**（最小权限，仅目标桶对象级读写），禁止使用主账号密钥。
# 权限策略示例（注意：qcs 资源里 uid 之后是 **APPID**，即桶名后缀，不是账号 UIN）：
#   qcs::cos:<region>:uid/<APPID>:<bucket>/*
#   action: cos:PutObject / GetObject / HeadObject / DeleteObject / OptionsObject
#           + InitiateMultipartUpload / UploadPart / CompleteMultipartUpload /
#             AbortMultipartUpload / ListParts（大文件分片上传）
# 密钥不得提交 Git，也不得写入前端（前端只拿 CDN 公开地址）。
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=
# 对外访问域名（CDN）。落库 URL = 该域名 + '/' + storageKey，换 CDN 只改这一处。
# 必须是不含路径的 https 域名，否则启动失败。
# COS_CDN_DOMAIN=https://cdn.example.com
# COS 源站域名（仅服务端排障用，不落库）
# COS_SERVICE_DOMAIN=

# ---------- 前台缓存失效（Phase 4.8） ----------
# CMS 内容发布 / 下架 / 删除后，后端 POST 到前台的 /api/revalidate 精准失效缓存
# （按 tag / path），使前台无需重建、无需手动清 .next/cache 即可立即更新。
# 两项**必须同时配置**才启用；任一缺失则降级为「不通知」（仅记日志）。
# REVALIDATE_SECRET 必须与 bailing-ui 的 REVALIDATE_SECRET 完全一致；
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FRONTEND_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
# REVALIDATE_SECRET=

# ---------- 生产环境占位符（本阶段不配置，部署时填写） ----------
# PROD_DATABASE_URL=postgresql://USER:PASSWORD@PROD_HOST:5432/DB?schema=public
# PROD_CORS_ORIGINS=https://bailingwooden.com,https://admin.bailingwooden.com
# （COS / CDN 相关变量见上方「腾讯云 COS + CDN」章节，不再重复占位）

# ---------- 询盘邮件通知（SMTP） ----------
# 访客在前台提交询盘后，系统用该发件邮箱把询盘内容发送给承接业务员
# （业务员邮箱在后台「员工联系方式」维护；未分配时退化为 INQUIRY_NOTIFY_EMAIL）。
# 163 邮箱填：SMTP_HOST=smtp.163.com / SMTP_PORT=465 / SMTP_SECURE=true，
# SMTP_PASSWORD 填 **客户端授权码**（不是网页登录密码）。
# 四项必须同时配置才启用；缺失则降级为「询盘只入库不发信」。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Bailing Wooden Website
# 兜底收件箱 / 抄送箱（多个用逗号分隔）。留空时无承接人的询盘退化为发件邮箱自身。
INQUIRY_NOTIFY_EMAIL=
