# ============================================================
# Bailing Wooden Backend - 环境变量模板
# 复制为 .env 后填入本地真实值；.env 不得提交 Git。
# ============================================================

# ---------- PostgreSQL（本地 Docker） ----------
POSTGRES_USER=bailing
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=bailingwooden
# 仅绑定本机地址，不暴露公网
POSTGRES_PORT=5432

# Prisma 连接串（本地 Docker PostgreSQL）
DATABASE_URL=postgresql://bailing:replace-with-a-strong-local-password@127.0.0.1:5432/bailingwooden?schema=public

# ---------- 后端服务 ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# ---------- CORS ----------
# 允许访问本 API 的前端 Origin，逗号分隔。生产环境必须显式列出，禁止使用 *
# 3000 = 主站 bailing-ui；3001 = 管理后台 bailing-admin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ---------- 后台接口保护（RFQ 管理） ----------
# 保护 GET /api/v1/rfq、GET /api/v1/rfq/:id、PATCH /api/v1/rfq/:id/status。
# 请求需携带请求头：X-Admin-Token: <值>
# 未配置时后台接口不鉴权（仅限本地开发）；**生产环境必须配置一个强随机值**。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ---------- 管理员认证（Phase 4.1，JWT） ----------
# JWT 签名密钥。仅来自环境变量，**代码不提供任何默认密钥**；
# 生产环境缺失或短于 32 字符将直接启动失败；开发环境缺失时使用进程级
# 随机密钥（服务重启后已签发令牌全部失效）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# access token 有效期。阶段约定：仅 access token（建议 15m），不实现 refresh token。
JWT_EXPIRES_IN=15m

# ---------- 默认管理员种子（npm run prisma:seed 读取） ----------
# 未配置时 seed 跳过默认管理员创建；口令只以 bcrypt 哈希入库，禁止明文。
# **生产环境必须使用强随机口令**，示例仅为占位。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_NAME=Administrator

# ---------- 生产环境占位符（本阶段不配置，部署时填写） ----------
# PROD_DATABASE_URL=postgresql://USER:PASSWORD@PROD_HOST:5432/DB?schema=public
# PROD_CORS_ORIGINS=https://bailingwooden.com,https://admin.bailingwooden.com
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# INQUIRY_NOTIFY_EMAIL=
